---
// Light / dark for the docs. The first visit follows the system; a choice is remembered on this device.
---

<button type="button" class="theme" data-theme-toggle aria-label="Toggle light and dark theme">
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
</button>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset['theme'] === 'light' ? 'dark' : 'light';
    root.dataset['theme'] = next;
    try {
      localStorage.setItem('pitwall-theme', next);
    } catch {
      // storage blocked: the choice lasts for this page only
    }
  });
</script>

<style>
  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--d-muted);
    cursor: pointer;
    transition: color 0.3s, background 0.3s;
  }
  .theme:hover { color: var(--d-text); background: var(--d-hover); }
  .theme svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .sun { display: none; }
  :global(:root[data-theme='dark']) .sun { display: block; }
  :global(:root[data-theme='dark']) .moon { display: none; }
</style>
