---
// Docs page layout: a calm manual, after the docs developers say they like to read (Better Auth, Impeccable).
// Plain sentence-case headings, a short sidebar of plain names (the principles fold under one heading),
// copy buttons, prev / next, ⌘K search, light and dark, English and Thai.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import Menu from '../components/Menu.astro';
import Search from '../components/Search.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { href, languages, t, ui, type Lang } from '../i18n/ui';
import { FLAT, NAV, PARENTS, docPath, groupName, groupOf, mdPath, sourcePath, words, type NavGroup, type NavItem } from '../docs/nav';

interface Props {
  /** The agent's file; a guide-only page (parallel laps, auto merge) has none. */
  entry?: CollectionEntry<'overview' | 'playbooks' | 'principles'> | undefined;
  item: NavItem;
  /** A page written for people; when present the playbook folds below it. */
  guide?: CollectionEntry<'guides' | 'guidesTh'> | undefined;
  lang?: Lang;
  /** false keeps the page out of the search index (the preview route). */
  index?: boolean;
}

const { entry, item, guide, lang = 'en', index = true } = Astro.props;
const tr = t(lang);
const own = entry ? await render(entry) : undefined;
const guided = guide ? await render(guide) : undefined;
const Content = own?.Content;
const Guide = guided?.Content;
const toc = (guided?.headings ?? own?.headings ?? []).filter((h) => h.depth === 2);
const at = FLAT.indexOf(item);
const prev = at > 0 ? FLAT[at - 1] : undefined;
const next = at >= 0 && at < FLAT.length - 1 ? FLAT[at + 1] : undefined;
const here = href(docPath(item, lang));
const { label, summary } = words(item, lang);
const repo = 'https://github.com/aontwit/pitwall/blob/main/';
const pageMd = new URL(href(mdPath(item)), Astro.site).toString();
const askClaude = `https://claude.ai/new?q=${encodeURIComponent(tr('docs.askPrompt', { url: pageMd }))}`;
// a Thai page with no Thai guide shows the agent's English text under a Thai title
const untranslated = lang !== 'en' && !guided;

// the sidebar: plain groups, then one heading over the groups that share a parent (open on its own pages)
type Block = { group: NavGroup } | { parent: string; groups: NavGroup[] };
const blocks: Block[] = [];
for (const g of NAV) {
  const last = blocks.at(-1);
  if (!g.parent) blocks.push({ group: g });
  else if (last && 'parent' in last && last.parent === g.parent) last.groups.push(g);
  else blocks.push({ parent: g.parent, groups: [g] });
}
const holds = (gs: NavGroup[]): boolean => gs.some((g) => g.items.includes(item));
const link = (i: NavItem) => ({ href: href(docPath(i, lang)), current: href(docPath(i, lang)) === here ? ('page' as const) : undefined, text: words(i, lang).label });
---

<Base title={`${label} · pitwall docs`} description={summary} lang={lang}>
  <script is:inline slot="head">
    // before first paint: the saved choice, else the system's
    (() => {
      let t = null;
      try { t = localStorage.getItem('pitwall-theme'); } catch {}
      document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    })();
  </script>

  <div class="docs" data-copy={tr('hero.copy')} data-copied={tr('hero.copied')}>
    <header class="bar">
      <a class="wordmark" href={href('/')}><span>pit</span>wall</a>
      <a class="bar-docs" href={href(docPath(FLAT[0] ?? item, lang))}>{tr('nav.docs')}</a>
      <Search lang={lang} />
      <div class="bar-end">
        <nav class="langs" aria-label="Language">
          {
            languages.map((l) => (
              <a href={href(docPath(item, l))} lang={l} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
                {ui[l]['lang.name']}
              </a>
            ))
          }
        </nav>
        <a class="icon-link" href="https://github.com/aontwit/pitwall" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.7s.8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z" /></svg>
        </a>
        <ThemeToggle />
        <Menu lang={lang} />
      </div>
    </header>

    <div class="shell">
      <aside class="side">
        <button type="button" class="side-toggle" aria-expanded="false" aria-controls="docs-nav" data-side-toggle>
          <span class="side-where">{groupOf(item, lang)}</span>
          <span class="side-current">{label}</span>
        </button>
        <nav id="docs-nav" aria-label={tr('nav.docs')}>
          {
            blocks.map((b) =>
              'group' in b ? (
                <section>
                  <p class="group">{groupName(b.group.id, b.group.group, lang)}</p>
                  <ul>
                    {b.group.items.map(link).map((l) => (
                      <li>
                        <a class="item" href={l.href} aria-current={l.current}>{l.text}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              ) : (
                <details class="fold" open={holds(b.groups)}>
                  <summary class="group">{groupName(b.parent, PARENTS[b.parent] ?? b.parent, lang)}</summary>
                  {b.groups.map((g) => (
                    <section>
                      <p class="subgroup">{groupName(g.id, g.group, lang)}</p>
                      <ul>
                        {g.items.map(link).map((l) => (
                          <li>
                            <a class="item" href={l.href} aria-current={l.current}>{l.text}</a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </details>
              ),
            )
          }
        </nav>
      </aside>

      <main class="page">
        <div data-pagefind-body={index ? '' : undefined}>
          <header class="page-head">
            <h1 data-pagefind-meta="title">{label}</h1>
            {summary && <p class="summary">{summary}</p>}
            <div class="actions" data-pagefind-ignore>
              {item.command && <code class="cmd-chip">{item.command}</code>}
              <button type="button" class="action" data-copy-md={href(mdPath(item))} data-done={tr('hero.copied')}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
                <span data-label>{tr('docs.copyMd')}</span>
              </button>
              <a class="action" href={askClaude} target="_blank" rel="noopener">{tr('docs.askClaude')} ↗</a>
              <a class="action" href={`${repo}${sourcePath(item)}`}>{tr('docs.source')} ↗</a>
            </div>
          </header>
          {untranslated && <p class="note" data-pagefind-ignore>{tr('docs.untranslated')}</p>}
          {
            Guide && Content ? (
              <>
                <div class="prose">
                  <Guide />
                </div>
                <details class="spec" id="agent-playbook">
                  <summary>
                    <span class="spec-title">{item.kind === 'overview' ? tr('docs.readme') : tr('docs.playbook')}</span>
                    <span class="spec-note">
                      {item.kind === 'overview' ? tr('docs.readmeNote') : tr('docs.playbookNote', { cmd: item.command ?? item.label })}
                    </span>
                  </summary>
                  <div class="prose" lang="en">
                    <Content />
                  </div>
                </details>
              </>
            ) : (
              <div class="prose" lang={untranslated ? 'en' : undefined}>
                {Guide ? <Guide /> : Content && <Content />}
              </div>
            )
          }
        </div>

        <nav class="pager" aria-label={`${tr('docs.prev')} / ${tr('docs.next')}`}>
          {
            prev && (
              <a class="pager-link" href={href(docPath(prev, lang))}>
                <span class="pager-dir">← {tr('docs.prev')}</span>
                <strong>{words(prev, lang).label}</strong>
              </a>
            )
          }
          {
            next && (
              <a class="pager-link next" href={href(docPath(next, lang))}>
                <span class="pager-dir">{tr('docs.next')} →</span>
                <strong>{words(next, lang).label}</strong>
              </a>
            )
          }
        </nav>
      </main>

      {
        toc.length > 1 && (
          <nav class="toc" aria-label={tr('docs.onThisPage')} data-toc>
            <p class="group">{tr('docs.onThisPage')}</p>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
              {guided && own && (
                <li>
                  <a href="#agent-playbook">{item.kind === 'overview' ? tr('docs.readmeToc') : tr('docs.playbookToc')}</a>
                </li>
              )}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</Base>

<script>
  // copy buttons on code blocks, labelled in the page's language
  const words = document.querySelector<HTMLElement>('.docs')?.dataset ?? {};
  const copy = words['copy'] ?? 'Copy';
  const copied = words['copied'] ?? 'Copied';
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-code';
    btn.textContent = copy;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      btn.textContent = copied;
      setTimeout(() => (btn.textContent = copy), 1400);
    });
    pre.append(btn);
  });

  // a # link beside each section heading
  document.querySelectorAll<HTMLHeadingElement>('.prose :is(h2, h3)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${h.id}`;
    a.setAttribute('aria-label', `Link to ${h.textContent ?? 'section'}`);
    a.textContent = '#';
    h.append(a);
  });

  // copy the page as markdown, for an agent or a chat
  document.querySelector<HTMLButtonElement>('[data-copy-md]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.querySelector<HTMLElement>('[data-label]');
    const text = await (await fetch(btn.dataset['copyMd'] ?? '')).text();
    await navigator.clipboard.writeText(text);
    if (label) {
      const was = label.textContent;
      label.textContent = btn.dataset['done'] ?? was;
      setTimeout(() => (label.textContent = was), 1400);
    }
  });

  // small screens: the navigation folds behind its current-page button
  const side = document.querySelector<HTMLButtonElement>('[data-side-toggle]');
  side?.addEventListener('click', () => {
    const open = side.getAttribute('aria-expanded') !== 'true';
    side.setAttribute('aria-expanded', String(open));
  });

  // the section being read is marked in "On this page": the last listed heading that has scrolled past the bar
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let queued = false;
    const mark = (): void => {
      queued = false;
      let current = 0;
      // at the very bottom the last sections can never reach the bar: take the last one on screen
      const bottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const line = bottom ? window.innerHeight * 0.75 : 120;
      targets.forEach((h, i) => {
        if (h && h.getBoundingClientRect().top < line) current = i;
      });
      links.forEach((a, i) => a.toggleAttribute('aria-current', i === current));
    };
    window.addEventListener('scroll', () => {
      if (!queued) requestAnimationFrame(mark);
      queued = true;
    }, { passive: true });
    mark();
  }
</script>

<style is:global>
  /* docs palette: carbon dark and paper light, one red */
  :root[data-theme='dark'] {
    --d-bg: rgb(21 21 30);
    --d-surface: rgb(27 27 38);
    --d-code: rgb(14 14 20);
    --d-text: rgb(236 236 241);
    --d-muted: rgb(236 236 241 / 0.74);
    --d-faint: rgb(236 236 241 / 0.5);
    --d-line: rgb(255 255 255 / 0.09);
    --d-line-strong: rgb(255 255 255 / 0.16);
    --d-hover: rgb(255 255 255 / 0.05);
    --d-accent: #ff4b3e;
    --d-accent-soft: rgb(225 6 0 / 0.12);
    color-scheme: dark;
  }
  :root[data-theme='light'] {
    --d-bg: rgb(250 250 249);
    --d-surface: rgb(255 255 255);
    --d-code: rgb(245 245 244);
    --d-text: rgb(20 20 24);
    --d-muted: rgb(20 20 24 / 0.72);
    --d-faint: rgb(20 20 24 / 0.5);
    --d-line: rgb(0 0 0 / 0.08);
    --d-line-strong: rgb(0 0 0 / 0.14);
    --d-hover: rgb(0 0 0 / 0.04);
    --d-accent: #d10600;
    --d-accent-soft: rgb(225 6 0 / 0.07);
    color-scheme: light;
  }
  :root[data-theme] body { background: var(--d-bg); color: var(--d-text); }

  /* code colours follow the theme (Shiki dual themes) */
  /* colour only on the tokens; the background belongs to the block, or every line gets a stripe */
  :root[data-theme='light'] .prose pre span { color: var(--shiki-light) !important; }
  :root[data-theme='light'] .prose pre { color: var(--shiki-light) !important; background-color: var(--d-code) !important; }
</style>

<style>
  .docs { min-height: 100svh; }

  /* ---------- top bar ---------- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
    padding: 0 var(--edge);
    border-bottom: 1px solid var(--d-line);
  }
  .bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--d-bg) 86%, transparent);
    backdrop-filter: blur(10px);
  }
  .wordmark { color: var(--d-text); font-size: 24px; }
  .bar-docs { padding-left: 16px; border-left: 1px solid var(--d-line-strong); font: 500 15px var(--font-body); color: var(--d-muted); text-decoration: none; margin-right: auto; }
  .bar-docs:hover { color: var(--d-text); }
  .bar-end { display: flex; align-items: center; gap: 6px; }
  /* the language switch: each name written in its own language */
  .langs { display: flex; gap: 2px; padding: 3px; border-radius: 8px; box-shadow: inset 0 0 0 1px var(--d-line); }
  .langs a { padding: 3px 9px; border-radius: 6px; font: 500 13px var(--font-body); color: var(--d-faint); text-decoration: none; }
  .langs a:hover { color: var(--d-text); }
  .langs a[aria-current] { background: var(--d-hover); color: var(--d-text); box-shadow: inset 0 0 0 1px var(--d-line-strong); }
  .langs a:lang(th) { font-family: 'Kanit', var(--font-body); }
  .bar-end :global(.menu-toggle) { color: var(--d-muted); font-size: 18px; margin-left: 12px; }
  .icon-link { display: grid; place-items: center; width: 36px; aspect-ratio: 1; border-radius: 50%; color: var(--d-muted); }
  .icon-link:hover { color: var(--d-text); background: var(--d-hover); }
  .icon-link svg { width: 19px; fill: currentColor; }

  /* ---------- three columns ---------- */
  .shell {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 220px;
    gap: 56px;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 var(--edge);
  }

  .side { position: sticky; top: 64px; align-self: start; max-height: calc(100svh - 64px); overflow-y: auto; padding: 28px 0 48px; }
  .side, .toc { scrollbar-width: thin; scrollbar-color: var(--d-line-strong) transparent; }
  .side-toggle { display: none; }
  .side nav > * + * { margin-top: 22px; }
  /* group names read as words, not as caps labels */
  .group { margin: 0 0 6px; font: 600 13px/1.4 var(--font-body); color: var(--d-text); }
  .subgroup { margin: 12px 0 4px; font: 500 12.5px/1.4 var(--font-body); color: var(--d-faint); }
  .fold summary { display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; }
  .fold summary::-webkit-details-marker { display: none; }
  .fold summary::after {
    content: '';
    width: 6px;
    aspect-ratio: 1;
    margin-right: 4px;
    border-right: 1.5px solid var(--d-faint);
    border-bottom: 1.5px solid var(--d-faint);
    rotate: -45deg;
    transition: rotate 0.2s var(--ease-move);
  }
  .fold[open] summary::after { rotate: 45deg; }
  .side ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .item {
    display: block;
    margin-left: -10px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--d-muted);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }
  .item:hover { color: var(--d-text); background: var(--d-hover); }
  .item[aria-current='page'] { color: var(--d-text); background: var(--d-accent-soft); box-shadow: inset 2px 0 0 var(--d-accent); font-weight: 500; }

  /* ---------- the page ---------- */
  .page { min-width: 0; max-width: 740px; padding: 40px 0 96px; }
  @media (prefers-reduced-motion: no-preference) {
    .page { animation: arrive 0.45s var(--ease-move) backwards; }
  }
  @keyframes arrive { from { opacity: 0; translate: 0 6px; } }

  h1 {
    margin: 0;
    font: 600 clamp(30px, 3.4vw, 38px) / 1.15 var(--font-body);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cmd-chip {
    margin-right: 4px;
    padding: 5px 10px;
    border-radius: 7px;
    background: var(--d-accent-soft);
    color: var(--d-accent);
    font: 500 13.5px var(--font-mono);
  }
  .summary { margin: 10px 0 0; max-width: 62ch; font-size: 17px; line-height: 1.55; color: var(--d-muted); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 20px 0 0; padding-bottom: 24px; border-bottom: 1px solid var(--d-line); }
  .note {
    margin: 20px 0 0;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--d-hover);
    color: var(--d-muted);
    font-size: 14.5px;
  }
  .note + .prose { padding-top: 16px; }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border: 0;
    border-radius: 7px;
    background: none;
    box-shadow: inset 0 0 0 1px var(--d-line-strong);
    color: var(--d-muted);
    font: 500 13px var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s, box-shadow 0.2s;
  }
  .action:hover { color: var(--d-text); box-shadow: inset 0 0 0 1px var(--d-faint); }
  .action svg { width: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }

  /* ---------- prose: written to be read ---------- */
  .prose { padding-top: 4px; font-size: 16.5px; line-height: 1.75; color: var(--d-muted); }
  .prose :global(h1) { display: none; } /* the page head shows the title */
  .prose :global(h2),
  .prose :global(h3) {
    position: relative;
    color: var(--d-text);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.3;
    scroll-margin-top: 88px;
  }
  .prose :global(h2) { margin: 44px 0 12px; font-size: 23px; letter-spacing: -0.01em; }
  .prose :global(h3) { margin: 30px 0 8px; font-size: 18px; }
  .prose :global(.anchor) {
    margin-left: 10px;
    color: var(--d-faint);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .prose :global(:is(h2, h3):hover .anchor), .prose :global(.anchor:focus-visible) { opacity: 1; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(strong) { color: var(--d-text); font-weight: 600; }
  .prose :global(a) { color: var(--d-text); text-decoration: underline; text-decoration-color: var(--d-accent); text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--d-accent); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; padding-left: 1.3em; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(li::marker) { color: var(--d-faint); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--d-line); margin: 44px 0; }
  .prose :global(blockquote) {
    margin: 24px 0;
    padding: 14px 18px;
    border-radius: 8px;
    background: var(--d-accent-soft);
    box-shadow: inset 3px 0 0 var(--d-accent);
    color: var(--d-text);
  }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--d-hover);
    box-shadow: inset 0 0 0 1px var(--d-line);
    color: var(--d-text);
    font: 0.84em var(--font-mono);
  }
  .prose :global(code.cmd) { background: var(--d-accent-soft); box-shadow: none; color: var(--d-accent); font-weight: 500; }
  .prose :global(pre) {
    position: relative;
    margin: 20px 0 24px;
    padding: 18px 20px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--d-line);
    overflow-x: auto;
    font: 14px/1.65 var(--font-mono);
  }
  .prose :global(.copy-code) {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 9px;
    border: 0;
    border-radius: 6px;
    background: var(--d-surface);
    box-shadow: inset 0 0 0 1px var(--d-line-strong);
    color: var(--d-muted);
    font: 500 12px var(--font-body);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .prose :global(pre:hover .copy-code), .prose :global(.copy-code:focus-visible) { opacity: 1; }
