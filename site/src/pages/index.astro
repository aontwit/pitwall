---
import Base from '../layouts/Base.astro';
import Menu from '../components/Menu.astro';
import { defaultLang, href, t } from '../i18n/ui';
import plugin from '../../../plugin/.claude-plugin/plugin.json';

const tr = t(defaultLang);
const repo = 'https://github.com/aontwit/pitwall';
// the three steps from the README's quick start, each copied on its own (Claude Code runs one command at a time)
const install = ['/plugin marketplace add aontwit/pitwall', '/plugin install pitwall@pitwall', '/pitwall:init'];

type Option = { command: string; to: string };
const doc = (command: string, to: string): Option => ({ command, to: href(to) });

// Stroke icons for the stage nodes, 24×24.
const ICONS = {
  plan: 'M9 3.5h6v3H9zM7.5 5H5.5v15.5h13V5h-2M8.5 11h7M8.5 14.5h7M8.5 18h4',
  queue: 'M4 6.5h2M4 12h2M4 17.5h2M9 6.5h11M9 12h11M9 17.5h11',
  lap: 'M3 10.5v5M3 13h2.5M5.5 9.5h3V8h6v1.5h2l2.5 2.5h1.5v-1.5h1.5v6h-1.5V15h-1.5L16 17.5H8.5l-3-3z',
  verify: 'M5 12.5l4.5 4.5L19 7.5',
  merge: 'M7 7v12M7 9.5c0 5.5 10 3.5 10 7.5M5 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M15 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
} as const;

const stages: { label: string; icon: keyof typeof ICONS; title: string; lede: string; options: Option[] }[] = [
  {
    label: 'Plan',
    icon: 'plan',
    title: 'Interview, then write the rows',
    lede: 'Short rounds of tick-box questions. Every answer lands in the spec before the next round, and the plan ends as rows the queue can pick.',
    options: [doc('/pitwall:init', 'docs/playbooks/init/'), doc('/pitwall:plan', 'docs/playbooks/plan/')],
  },
  {
    label: 'Queue',
    icon: 'queue',
    title: 'Ask every question once',
    lede: 'Pick the tasks the agent can finish alone, then ask everything only a human can decide, up front, as tick boxes. Nobody gets asked at 2am.',
    options: [doc('/pitwall:queue', 'docs/playbooks/queue/')],
  },
  {
    label: 'Lap',
    icon: 'lap',
    title: 'The engine: one task per round',
    lede: 'Branch from base, code by playbook, prove it, review it, open the PR. The round never waits on a human for something it can decide.',
    options: [
      doc('/pitwall:drive', 'docs/playbooks/drive/'),
      doc('/pitwall:lap', 'docs/playbooks/lap/'),
      doc('/pitwall:stop', 'docs/playbooks/stop/'),
      doc('/pitwall:brake', 'docs/playbooks/brake/'),
      doc('parallel: 2', 'docs/playbooks/parallel-laps/'),
    ],
  },
  {
    label: 'Verify',
    icon: 'verify',
    title: 'Evidence, not claims',
    lede: 'Checks run, the page is driven in a browser, and a verifier that did not write the code gives a verdict pinned to the patch-id.',
    options: [
      doc('/pitwall:gauge', 'docs/playbooks/gauge/'),
      doc('prove-it-works', 'docs/principles/prove-it-works/'),
    ],
  },
  {
    label: 'Merge',
    icon: 'merge',
    title: 'Humans merge',
    lede: 'Open PRs are ordered by stack and readiness. No force-push, no push to a protected branch, and a merge only into your dev branch, if you opt in.',
    options: [
      doc('/pitwall:merge-order', 'docs/playbooks/merge-order/'),
      doc('opening-a-pr', 'docs/playbooks/opening-a-pr/'),
      doc('merge: auto', 'docs/playbooks/auto-merge/'),
    ],
  },
];

// The engine on the Lap stage, one part per step of a round (in the order the round runs).
const engineParts = [
  { key: 'intake', name: 'Intake', step: 'Pick the next task', side: 'right' },
  { key: 'pistons', name: 'Pistons', step: 'Code, a subagent per role', side: 'right' },
  { key: 'ignition', name: 'Ignition', step: 'Gauge runs the proof', side: 'left' },
  { key: 'heads', name: 'Heads', step: 'Review panel, two models', side: 'left' }, // on the right it runs into the stage's commands
  { key: 'crank', name: 'Crank', step: 'Verifier at the patch-id', side: 'left' },
  { key: 'exhaust', name: 'Exhaust', step: 'Open the PR', side: 'right' },
];

// Speed gauge: 0-360 km/h over a 240 degree sweep, a tick every 20, a number every 40.
const sweep = (kmh: number) => ((-120 + (kmh / 360) * 240) * Math.PI) / 180;
const at = (kmh: number, r: number) => ({ x: 100 + r * Math.sin(sweep(kmh)), y: 100 - r * Math.cos(sweep(kmh)) });
const ticks = Array.from({ length: 19 }, (_, i) => {
  const major = i % 2 === 0;
  const a = at(i * 20, major ? 78 : 84);
  const b = at(i * 20, 90);
  const n = at(i * 20, 64);
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, major, n: i * 20, tx: n.x, ty: n.y + 4 };
});
const arc = (from: number, to: number) => {
  const a = at(from, 90);
  const b = at(to, 90);
  return `M ${a.x} ${a.y} A 90 90 0 ${to - from > 270 ? 1 : 0} 1 ${b.x} ${b.y}`;
};
// the speeds Drive times from a standing start, km/h (the car makes 300 in about 10 s)
const marks = [100, 200, 300];
// what search engines read the page as
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'pitwall',
  description: 'A Claude Code plugin: the agent loop that queues your work, proves every PR, and leaves the merge to you.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Claude Code',
  softwareVersion: plugin.version,
  license: 'https://opensource.org/licenses/MIT',
  url: Astro.site?.toString(),
  sameAs: 'https://github.com/aontwit/pitwall',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base title="pitwall — a Claude Code plugin that proves every PR">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="stage" data-stage-root>
    <script is:inline>
      // Hold the ring, the stepper and Drive back until the start lights go out (the page script below runs them).
      // Set before the first paint, so they never flash in and out; reduced motion skips the show altogether.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('is-arming');
    </script>
    <canvas class="scene" aria-hidden="true"></canvas>
    <!-- the image is only fetched when it is shown: no WebGL, or reduced motion -->
    <div class="poster" aria-hidden="true" style={`--poster: url(${href('hero-poster.jpg')})`}></div>
    <div class="ring" aria-hidden="true"></div>
    <div class="gantry" data-gantry aria-hidden="true">{Array.from({ length: 5 }, () => <span />)}</div>

    <header class="chrome top">
      <a class="wordmark" href={href('/')}><span>pit</span>wall</a>
      <Menu />
    </header>

    <div class="intro">
      <h1 class="pitch">The agent loop for Claude Code. It queues your work, proves every PR, and leaves the merge to you.</h1>
      <div class="panels">
        {
          stages.map((s, i) => (
            <section data-panel hidden={i !== 0} aria-live="polite">
              {/* each word rises out of its own slot */}
              <h2 class="title label">
                {s.title.split(' ').map((word, k) => (
                  <>
                    <span class="word" style={`--k: ${k}`}>
                      <span>{word}</span>
                    </span>{' '}
                  </>
                ))}
              </h2>
              <p class="lede">{s.lede}</p>
            </section>
          ))
        }
      </div>
    </div>

    <nav class="stepper" aria-label="The loop">
      <ol>
        {
          stages.map((s, i) => (
            <li style={`--i: ${i}`}>
              <button type="button" data-step aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="step-label label">{s.label}</span>
                <span class="node">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[s.icon]} /></svg>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      stages.map((s, i) => (
        <ul class="options label" data-option hidden={i !== 0}>
          {s.options.map((o, j) => (
            <li style={`--j: ${j}`}>
              <a href={o.to}>
                <span class="dot" />
                {o.command}
              </a>
            </li>
          ))}
        </ul>
      ))
    }

    <div class="parts" aria-hidden="true">
      {
        engineParts.map((p, i) => (
          <div class="part" data-part={p.key} data-side={p.side}>
            <span class="part-name label">
              {String(i + 1).padStart(2, '0')} <span class="part-word">{p.name}</span>
            </span>
            <span class="part-step">{p.step}</span>
          </div>
        ))
      }
    </div>
    <!-- phone: the parts carry only their number, and the names and steps sit in a key below the stepper -->
    <ol class="legend" aria-hidden="true">
      {
        engineParts.map((p, i) => (
          <li>
            <span class="part-name label">
              {String(i + 1).padStart(2, '0')} {p.name}
            </span>
            <span class="part-step">{p.step}</span>
          </li>
        ))
      }
    </ol>

    <div class="hud" data-hud hidden>
      <div class="lights" aria-hidden="true">{Array.from({ length: 15 }, () => <span />)}</div>
      <svg class="gauge" viewBox="0 0 200 200" role="img" aria-label="Speed">
        <path class="gauge-arc" d={arc(0, 360)} />
        <path class="gauge-red" d={arc(300, 360)} />
        {ticks.map((k) => <line class:list={['tick', { major: k.major }]} x1={k.x1} y1={k.y1} x2={k.x2} y2={k.y2} />)}
        {ticks.filter((k) => k.major).map((k) => <text class="tick-n" x={k.tx} y={k.ty}>{k.n}</text>)}
        <line class="needle" data-needle x1="100" y1="112" x2="100" y2="22" transform="rotate(-120 100 100)" />
        <circle class="hub" cx="100" cy="100" r="6" />
        <text class="speed" data-speed x="100" y="146">0</text>
        <text class="unit" x="100" y="162">KM/H</text>
      </svg>
      <p class="gear label" data-gear>N</p>
      <div class="pedals" aria-hidden="true">
        <span class="pedal"><span class="pedal-fill brake" data-pedal="brake"></span></span>
        <span class="pedal"><span class="pedal-fill throttle" data-pedal="throttle"></span></span>
      </div>
      <!-- splits from a standing start, timed as the pit wall would -->
      <dl class="splits">
        {
          marks.map((m) => (
            <div>
              <dt class="label">0–{m}</dt>
              <dd class="label" data-split={m}>–</dd>
            </div>
          ))
        }
      </dl>
      <p class="hint">{tr('drive.hint')}</p>
    </div>

    <div class="pads" data-pads hidden>
      <div class="pad-group">
        <button type="button" class="pad" data-key="left" aria-label={tr('drive.left')}>
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M6.5 2L3.5 5L6.5 8" /></svg>
        </button>
        <button type="button" class="pad" data-key="right" aria-label={tr('drive.right')}>
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 2L6.5 5L3.5 8" /></svg>
        </button>
      </div>
      <div class="pad-group">
        <button type="button" class="pad label" data-key="down" aria-label={tr('drive.brake')}>BRK</button>
        <button type="button" class="pad pad-go label" data-key="up" aria-label={tr('drive.throttle')}>GO</button>
      </div>
    </div>

    <div class="drive-ctl">
      <p class="debrief label" data-debrief data-best={tr('drive.best')} data-top={tr('drive.top')} role="status"></p>
      <div class="keys" aria-hidden="true">
        <span class="cap" data-cap="up"><svg viewBox="0 0 10 10"><path d="M2 6.5L5 3.5L8 6.5" /></svg></span>
        <span class="cap" data-cap="left"><svg viewBox="0 0 10 10"><path d="M6.5 2L3.5 5L6.5 8" /></svg></span>
        <span class="cap" data-cap="down"><svg viewBox="0 0 10 10"><path d="M2 3.5L5 6.5L8 3.5" /></svg></span>
        <span class="cap" data-cap="right"><svg viewBox="0 0 10 10"><path d="M3.5 2L6.5 5L3.5 8" /></svg></span>
      </div>
      <button type="button" class="drive-toggle" data-drive data-on={tr('drive.start')} data-off={tr('drive.exit')} aria-pressed="false">
        <svg class="drive-chevrons" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M45 6L50 1L55 6" /><path d="M6 45L1 50L6 55" /><path d="M94 45L99 50L94 55" />
        </svg>
        <span class="label" data-drive-label>{tr('drive.start')}</span>
      </button>
    </div>

    <footer class="chrome bottom">
      <a class="corner label" href="https://github.com/aontwit/pitwall/blob/main/CHANGELOG.md">v{plugin.version}</a>
      <div class="start">
        <p class="eyebrow label">{tr('hero.install')}</p>
        <ol class="install">
          {
            install.map((cmd) => (
              <li>
                <code>{cmd}</code>
                <button type="button" class="copy label" data-copy={cmd} data-done={tr('hero.copied')}>
                  <span data-copy-label>{tr('hero.copy')}</span><span class="visually-hidden"> {cmd}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="cta label" href={href('docs/')}>{tr('hero.cta')}</a>
          <a class="star label" href={repo}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
            {tr('hero.star')}
          </a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<script>
  import { mountCar, type Scene } from '../scripts/car';
  import { href } from '../i18n/ui';

  const root = document.querySelector<HTMLElement>('[data-stage-root]');
  const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const options = [...document.querySelectorAll<HTMLElement>('[data-option]')];
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  let scene: Scene | undefined;
  const canvas = root?.querySelector<HTMLCanvasElement>('.scene');
  const labels = new Map([...document.querySelectorAll<HTMLElement>('[data-part]')].map((el) => [el.dataset['part'] ?? '', el]));
  // Ask the browser first: with WebGL off (hardware acceleration disabled, a blocked GPU) three.js would
  // only fail loudly. A browser without it, or a reader who asked for less motion, gets the still image.
  const webgl = ((): boolean => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return gl !== null;
    } catch {
      return false;
    }
  })();
  if (canvas && webgl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    try {
      scene = mountCar(canvas, { base: href(''), labels });
    } catch {
      scene = undefined; // a context that still failed to start
    }
  }

  // ---------- start lights: on arrival they count the car in, in Drive they start the race ----------
  const bulbs = [...document.querySelectorAll<HTMLElement>('[data-gantry] span')];
  let lightsTimer = 0;
  const light = (n: number): void => bulbs.forEach((b, i) => b.classList.toggle('on', i < n));
  const stopLights = (): void => {
    clearTimeout(lightsTimer);
    light(0);
  };
  /** The lamps come on one by one, no faster than `pace` ms and no further than `allowed()`; all five lit, a random hold, then lights out. */
  const runLights = (pace: number, allowed: () => number, out: () => void): void => {
    clearTimeout(lightsTimer);
    let n = 0;
    const next = (): void => {
      if (n < allowed()) light(++n);
      lightsTimer =
        n < bulbs.length
          ? window.setTimeout(next, pace)
          : window.setTimeout(() => {
              light(0);
              out();
            }, 250 + Math.random() * 450); // never the same hold twice, as at a real start
    };
    next();
  };

  /** No scene (no WebGL, reduced motion, or the car failed to load): the still image, and nothing to drive. */
  const still = (): void => {
    stopLights();
    scene?.dispose();
    scene = undefined;
    root?.classList.remove('is-arming');
    root?.classList.add('static-hero');
  };
  if (!scene) still();
  else {
    // four lamps follow the car's download and the fifth comes on once it is on the stage; a slow line gets the
    // stage after 5 s anyway, and the car paints in when it lands
    const since = performance.now();
    let loaded = false;
    scene.ready.then(() => (loaded = true), still);
    runLights(
      180,
      () => (loaded || performance.now() - since > 5000 ? 5 : 1 + Math.floor((scene?.progress() ?? 0) * 3.99)),
      () => {
        scene?.reveal();
        root?.classList.remove('is-arming');
      },
    );
  }

  let active = 0;
  let changed = 0; // when the stage last changed: a scroll moves one stage at a time
  const leaving: number[] = [];
  const select = (n: number): void => {
    if (n === active || n < 0 || n >= steps.length) return;
    steps.forEach((s, i) => s.setAttribute('aria-pressed', String(i === n)));
    // the old text steps out while the new one comes in, in the same grid cell
    panels.forEach((p, i) => {
      clearTimeout(leaving[i]);
      p.removeAttribute('data-leaving');
      if (i === n) p.hidden = false;
      else if (i === active && !p.hidden) {
        p.setAttribute('data-leaving', '');
        leaving[i] = window.setTimeout(() => {
          p.hidden = true;
          p.removeAttribute('data-leaving');
        }, 280);
      } else p.hidden = true;
    });
    options.forEach((o, i) => (o.hidden = i !== n));
    root?.style.setProperty('--active', String(n));
    root?.classList.toggle('is-engine', n === 2); // the exploded engine needs the bottom of the stage
    scene?.focus(n);
    active = n;
    changed = performance.now();
  };
  steps.forEach((s, i) => s.addEventListener('click', () => select(i)));

  // arrow keys walk the loop from any node
  document.querySelector('.stepper')?.addEventListener('keydown', (e) => {
    const { key } = e as KeyboardEvent;
    const d = key === 'ArrowDown' || key === 'ArrowRight' ? 1 : key === 'ArrowUp' || key === 'ArrowLeft' ? -1 : 0;
    if (!d) return;
    e.preventDefault();
    select(active + d);
    steps[active]?.focus();
  });

  // A scroll moves one stage per gesture: a trackpad flick keeps sending wheel events long after the
  // fingers lift, so a gesture only ends after a short quiet gap.
  let wheelAt = 0;
  let wheelSum = 0;
  let wheelSpent = false;
  root?.addEventListener(
    'wheel',
    (e) => {
      if (driving || menu?.hasAttribute('data-open')) return;
      const now = performance.now();
      if (now - wheelAt > 160) {
        wheelSpent = false;
        wheelSum = 0;
      }
      wheelAt = now;
      if (wheelSpent || now - changed < 700) return;
      wheelSum += e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY; // Firefox counts a mouse wheel in lines
      if (Math.abs(wheelSum) < 40) return;
      wheelSpent = true;
      select(active + Math.sign(wheelSum));
    },
    { passive: true },
  );

  // on a touch screen, a sideways swipe across the car does the same
  let swipe: { x: number; y: number } | undefined;
  canvas?.addEventListener('pointerdown', (e) => {
    swipe = e.pointerType === 'mouse' || driving ? undefined : { x: e.clientX, y: e.clientY };
  });
  canvas?.addEventListener('pointerup', (e) => {
    if (!swipe) return;
    const dx = e.clientX - swipe.x;
    const dy = e.clientY - swipe.y;
    swipe = undefined;
    if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) select(active - Math.sign(dx));
  });
  canvas?.addEventListener('pointercancel', () => (swipe = undefined));

  // ---------- drive mode ----------
  const toggle = document.querySelector<HTMLButtonElement>('[data-drive]');
  const hud = document.querySelector<HTMLElement>('[data-hud]');
  const pads = document.querySelector<HTMLElement>('[data-pads]');
  const needle = document.querySelector<SVGLineElement>('[data-needle]');
  const speed = document.querySelector<SVGTextElement>('[data-speed]');
  const gear = document.querySelector<HTMLElement>('[data-gear]');
  const lights = [...document.querySelectorAll<HTMLElement>('.lights span')];
  const pedalBrake = document.querySelector<HTMLElement>('[data-pedal="brake"]');
  const pedalThrottle = document.querySelector<HTMLElement>('[data-pedal="throttle"]');
  let lastShifts = 0;
  const held = new Set<string>();
  let driving = false;
  let hudFrame = 0;

  // the pit wall's numbers: each run from a standing start is timed to 100, 200 and 300 km/h, the visit keeps the best
  const splits = [...document.querySelectorAll<HTMLElement>('[data-split]')];
  const best: number[] = [];
  let runFrom = -1; // when the car last pulled away from rest
  let passed = 0; // how many marks this run has passed
  let topKmh = 0;
  const timeSplits = (kmh: number): void => {
    const now = performance.now();
    if (kmh < 1) runFrom = -1; // at rest: the next pull-away is a new run
    else if (runFrom < 0) {
      runFrom = now;
      passed = 0;
      splits.forEach((s) => {
        s.textContent = '–';
        s.classList.remove('set', 'best');
      });
    }
    for (const s of splits.slice(passed)) {
      if (runFrom < 0 || kmh < Number(s.dataset['split'])) break;
      const time = (now - runFrom) / 1000;
      const pb = !((best[passed] ?? Infinity) <= time);
      if (pb) best[passed] = time;
      s.textContent = time.toFixed(2);
      s.classList.add('set');
      s.classList.toggle('best', pb);
      passed += 1;
    }
    topKmh = Math.max(topKmh, kmh);
  };

  // back in the pits, the best split of the visit and its top speed stay up for a few seconds
  const brief = document.querySelector<HTMLElement>('[data-debrief]');
  let briefTimer = 0;
  const debrief = (): void => {
    const i = best.length - 1;
    const mark = splits[i]?.dataset['split'];
    if (!brief || !mark) return;
    brief.textContent = `${brief.dataset['best']} 0–${mark} km/h ${best[i]?.toFixed(2)} s · ${brief.dataset['top']} ${Math.round(topKmh)} km/h`;
    brief.classList.add('on');
    clearTimeout(briefTimer);
    briefTimer = window.setTimeout(() => brief.classList.remove('on'), 7000);
  };

  const caps = [...document.querySelectorAll<HTMLElement>('[data-cap]')];
  const push = (): void => {
    caps.forEach((c) => c.classList.toggle('on', held.has(c.dataset['cap'] ?? '')));
    scene?.input({
      throttle: held.has('up') ? 1 : 0,
      brake: held.has('down') ? 1 : 0,
      steer: (held.has('left') ? 1 : 0) - (held.has('right') ? 1 : 0),
    });
  };

  const drawHud = (): void => {
    if (!scene) return;
    const { kmh, gear: g, rpm, throttle, brake, shifts } = scene.telemetry();
    needle?.setAttribute('transform', `rotate(${-120 + (Math.min(kmh, 360) / 360) * 240} 100 100)`);
    if (speed) speed.textContent = String(Math.round(kmh));
    if (gear) {
      gear.textContent = g === 0 ? 'N' : String(g);
      if (shifts !== lastShifts) {
        // restart the flash on every shift, up or down
        gear.classList.remove('shift');
        void gear.offsetWidth;
        gear.classList.add('shift');
        lastShifts = shifts;
      }
    }
    // shift lights fill from 7,000 rpm and are all lit at the 11,600 rpm upshift point
    const lit = Math.round(((rpm - 7000) / 4600) * lights.length);
    lights.forEach((l, i) => l.classList.toggle('on', i < lit));
    pedalBrake?.style.setProperty('scale', `1 ${brake}`);
    pedalThrottle?.style.setProperty('scale', `1 ${throttle}`);
    timeSplits(kmh);
    hudFrame = requestAnimationFrame(drawHud);
  };

  const setDriving = (on: boolean): void => {
    if (!scene) return;
    driving = on;
    held.clear();
    scene.drive(on);
    root?.classList.toggle('is-driving', on);
    // the start: five red lights over the grid (rev it up meanwhile), then lights out and away
    root?.toggleAttribute('data-staged', on);
    if (on) {
      brief?.classList.remove('on');
      runLights(
        360,
        () => 5,
        () => {
          root?.removeAttribute('data-staged');
          scene?.launch();
        },
      );
    } else {
      stopLights();
      debrief();
    }
    if (hud) hud.hidden = !on;
    if (pads) pads.hidden = !on || !matchMedia('(pointer: coarse)').matches;
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(on));
      const label = toggle.querySelector<HTMLElement>('[data-drive-label]');
      if (label) label.textContent = (on ? toggle.dataset['off'] : toggle.dataset['on']) ?? '';
    }
    cancelAnimationFrame(hudFrame);
    if (on) hudFrame = requestAnimationFrame(drawHud);
  };
  toggle?.addEventListener('click', () => setDriving(!driving));
  if (!scene && toggle) toggle.hidden = true;

  const keyMap: Record<string, string> = {
    ArrowUp: 'up',
    KeyW: 'up',
    ArrowDown: 'down',
    KeyS: 'down',
    Space: 'down',
    ArrowLeft: 'left',
    KeyA: 'left',
    ArrowRight: 'right',
    KeyD: 'right',
  };
  window.addEventListener('keydown', (e) => {
    if (!driving) return;
    if (e.code === 'Escape') return setDriving(false);
    const k = keyMap[e.code];
    if (!k) return;
    e.preventDefault(); // arrows and space must not scroll the page while driving
    held.add(k);
    push();
  });
  window.addEventListener('keyup', (e) => {
    const k = keyMap[e.code];
    if (!k) return;
    held.delete(k);
    push();
  });
  window.addEventListener('blur', () => {
    held.clear();
    push();
  });
  pads?.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) => {
    const k = b.dataset['key'] ?? '';
    const release = (): void => {
      held.delete(k);
      push();
    };
    b.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      b.setPointerCapture(e.pointerId);
      held.add(k);
      push();
    });
    b.addEventListener('pointerup', release);
    b.addEventListener('pointercancel', release);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const text = btn.querySelector<HTMLElement>('[data-copy-label]');
    if (!text) return;
    const label = text.textContent;
    let reset = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset['copy'] ?? '');
        text.textContent = btn.dataset['done'] ?? label;
      } catch {
        // clipboard blocked (permissions, insecure context): select the command so the reader can copy it
        const code = btn.parentElement?.querySelector('code');
        if (code) getSelection()?.selectAllChildren(code);
        text.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? 'Press ⌘C' : 'Press Ctrl+C';
      }
      clearTimeout(reset);
      reset = window.setTimeout(() => (text.textContent = label), 2400);
    });
  });
</script>

<style>
  .stage {
    --r: min(42vh, 34vw, 470px);
    --cy: 52%;
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% var(--cy), #1d1d29 0%, var(--bg) 60%, var(--bg-deep) 100%);
  }

  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y; /* a sideways swipe on the car changes stage */
  }

  /* the still image for browsers without WebGL and for reduced motion */
  .poster {
    position: absolute;
    inset: 0;
    background: center 52% / cover no-repeat;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s var(--ease-reveal);
  }
  .static-hero .poster { opacity: 1; background-image: var(--poster); }
  .static-hero .drive-ctl { display: none; } /* no scene, nothing to drive */
  @media (max-aspect-ratio: 1/1) {
    .poster { background-size: 150vw auto; }
  }

  .ring {
    position: absolute;
    left: 50%;
    top: var(--cy);
    width: calc(var(--r) * 2);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.7);
    box-shadow: -18px 0 60px -20px rgb(225 6 0 / 0.5), 18px 0 60px -20px rgb(225 6 0 / 0.3);
    /* faded out at top and bottom; the conic part draws the ring in, from the bottom round, at lights out */
    mask-image:
      linear-gradient(to bottom, transparent 4%, #000 30%, #000 70%, transparent 96%),
      conic-gradient(from 180deg, #000 var(--sweep), transparent 0);
    mask-composite: intersect;
    pointer-events: none;
    animation: draw 1.8s var(--ease-out) 0.1s backwards;
  }
  @property --sweep { syntax: '<angle>'; inherits: false; initial-value: 360deg; }
  @keyframes draw {
    from { --sweep: 0deg; }
  }

  /*
   * Arrival: until the start lights go out, the stage shows only the lamps (the class is set by an inline
   * script before the first paint). Lifting it starts each element's own entrance. If the page script never
   * runs, everything comes back on its own after 6 s.
   */
  .is-arming > :is(.ring, .stepper, .options, .drive-ctl) { opacity: 0; visibility: hidden; animation: unarm 0s 6s forwards; }
  .is-arming :is(.stepper li, .options li) { animation: none; }
  @keyframes unarm {
    to { opacity: 1; visibility: visible; }
  }

  /* the F1 start lights: five lamps that light one by one, then all go out at once */
  .gantry {
    position: absolute;
    left: 50%;
    top: var(--cy);
    translate: -50% -50%;
    z-index: 3;
    display: flex;
    gap: 14px;
    padding: 18px 26px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-move), top 0.8s var(--ease-out);
  }
  /* the gantry's beam */
  .gantry::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1.5px;
    background: linear-gradient(to right, transparent, rgb(255 255 255 / 0.35), transparent);
  }
  .gantry span {
    width: 22px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(19 19 27);
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.25);
    transition: background 0.08s, box-shadow 0.08s; /* lights out is instant */
  }
  .gantry span.on {
    background: radial-gradient(circle at 40% 35%, #ff8a80, var(--accent) 55%);
    box-shadow: 0 0 0 1.5px #ff6a60, 0 0 22px 6px rgb(225 6 0 / 0.55);
  }
  .is-arming .gantry, [data-staged] .gantry { opacity: 1; }
  /* in Drive the gantry hangs over the grid, above the car */
  [data-staged] .gantry, .is-driving .gantry { top: calc(var(--cy) - var(--r) * 0.55); }

  .chrome {
    position: absolute;
    inset-inline: var(--edge);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .top { top: var(--edge); z-index: 60; } /* above the stage UI, so the open menu covers it */
  .bottom {
    bottom: var(--edge);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
  }

  .corner {
    color: var(--t-60);
    text-decoration: none;
    transition: color 0.5s var(--ease-move);
  }
  .corner:hover { color: var(--text); }
  .corner { font-size: 16px; justify-self: start; } /* the link is the version, not the grid column */

  .intro {
    position: absolute;
    top: clamp(76px, 11vh, 110px);
    left: 50%;
    translate: -50% 0;
    width: min(780px, calc(100% - 2 * var(--edge)));
    text-align: center;
    z-index: 2;
  }
  /* the stage's text: the old panel steps out while the new one comes in, in the same cell */
  .panels { display: grid; }
  .panels > section { grid-area: 1 / 1; }
  .panels > [data-leaving] { animation: leave 0.28s var(--ease-move) forwards; pointer-events: none; }
  @keyframes leave {
    to { opacity: 0; filter: blur(4px); translate: 0 -6px; }
  }
  .pitch {
    margin: 0 auto 22px;
    max-width: 44ch;
    font: 500 clamp(16px, 1.4vw, 19px)/1.45 var(--font-body);
    color: var(--t-80);
    text-wrap: balance;
  }
  .eyebrow {
    margin: 0;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: var(--track-eyebrow);
    color: var(--t-80);
  }
  .title {
    margin: 0 0 10px;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.3;
    letter-spacing: var(--track-lede);
    text-wrap: balance;
  }
  /* each word rises out of its own slot, one after another */
  .word { display: inline-block; overflow: hidden; vertical-align: top; }
  .word > span { display: inline-block; }
  .panels > :not([hidden], [data-leaving]) .word > span {
    animation: rise 0.9s var(--ease-out) backwards;
    animation-delay: calc(var(--k) * 45ms + 60ms);
  }
  @keyframes rise {
    from { translate: 0 110%; }
  }
  .lede {
    margin: 0 auto;
    max-width: 66ch;
    font: 500 12px/20px var(--font-body);
    letter-spacing: var(--track-lede);
    text-transform: uppercase;
    text-wrap: pretty;
    color: var(--t-60);
    /* a dark halo keeps the words readable where they cross the car's light */
    text-shadow: 0 0 3px var(--bg), 0 0 12px var(--bg);
  }
  .panels > :not([hidden], [data-leaving]) .lede { animation: settle 1.1s var(--ease-out) 0.18s backwards; }
  @keyframes settle {
    from { opacity: 0; filter: blur(6px); translate: 0 6px; }
  }

  .stepper ol { list-style: none; margin: 0; padding: 0; }
  /* --slide moves a node or an option along the ring: on arrival they glide down it into place */
  @property --slide { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .stepper li {
    --a: calc(198deg - var(--i) * 9deg + var(--slide));
    --node: 48px;
    position: absolute;
    left: calc(50% + var(--r) * cos(var(--a)));
    top: calc(var(--cy) + var(--r) * sin(var(--a)));
    /* the node's centre, not the button's edge, lands on the ring */
    translate: calc(-100% + var(--node) / 2) -50%;
    z-index: 2;
    animation: along-left 1.3s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  @keyframes along-left {
    from { --slide: 26deg; opacity: 0; }
  }
  .stepper button {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .stepper button:focus-visible { box-shadow: none; }
  .step-label {
    font-size: 20px;
    opacity: 0.5; /* 5:1 on the stage: still readable, still clearly not the current one */
    transition: opacity 0.6s var(--ease-move);
  }
  .stepper button:hover .step-label, .stepper button:focus-visible .step-label { opacity: 0.8; }
  [aria-pressed='true'] .step-label { opacity: 1; }
  .node {
    display: grid;
    place-items: center;
    width: var(--node);
    aspect-ratio: 1;
    border-radius: 50%;
    /* opaque, so the ring never shows through */
    background: rgb(19 19 27);
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.32);
    color: var(--t-40);
    transition: box-shadow 0.6s var(--ease-move), color 0.6s var(--ease-move), scale 0.6s var(--ease-move);
  }
  .node svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .stepper button:hover .node { color: var(--t-80); box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.6); }
  .stepper button:focus-visible .node { box-shadow: var(--ring-glow); }
  [aria-pressed='true'] .node {
    scale: 1.14;
    color: var(--text);
    box-shadow: var(--ring-glow), 0 0 34px 10px rgb(255 255 255 / 0.1);
  }

  .options {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
  }
  .options li {
    --a: calc(-6deg + var(--j) * 5.5deg + var(--slide));
    position: absolute;
    left: calc(50% + var(--r) * cos(var(--a)));
    top: calc(var(--cy) + var(--r) * sin(var(--a)));
    translate: -8px -50%;
    z-index: 2;
  }
  /* a stage's commands glide down the right of the ring into place */
  .options:not([hidden]) li { animation: along-right 1s var(--ease-out) backwards; animation-delay: calc(var(--j) * 80ms + 120ms); }
  @keyframes along-right {
    from { --slide: -14deg; opacity: 0; }
  }
  .options a {
    display: flex;
    align-items: center;
    gap: 18px;
    white-space: nowrap;
    color: var(--t-60);
    text-decoration: none;
    transition: color 0.5s var(--ease-move);
  }
  .options li:first-child a, .options a:hover { color: var(--accent-muted); }
  .dot {
    width: 16px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 2px var(--t-40);
  }
  .options li:first-child .dot, .options a:hover .dot { box-shadow: 0 0 0 2px var(--accent-muted), 0 0 12px 2px rgb(225 6 0 / 0.45); }

  .start { grid-column: 2; text-align: center; display: grid; justify-items: center; gap: 10px; min-width: 0; }
  .install {
    list-style: none;
    margin: 0;
    padding: 4px;
    display: grid;
    gap: 2px;
    max-width: 100%;
    border-radius: 15px;
    background: rgb(11 11 16 / 0.7);
    box-shadow: 0 0 0 1px var(--line);
    backdrop-filter: blur(6px);
    counter-reset: step;
  }
  .install li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding-left: 12px;
    counter-increment: step;
  }
  .install li::before { content: counter(step); font: 400 12px/1 var(--font-mono); color: var(--t-40); }
  .install code {
    font: 400 13px/1.5 var(--font-mono);
    color: var(--t-80);
    text-align: left;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    /* a line too long for the row fades out at the edge, so it reads as scrollable rather than cut */
    mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent);
  }
  .install code::selection { background: var(--accent); color: var(--text); }
  .copy, .cta, .star {
    border: 0;
    border-radius: 15px;
    padding: 6px 14px;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.5s var(--ease-move), color 0.5s var(--ease-move);
  }
  .copy { min-width: 74px; background: rgb(255 255 255 / 0.08); color: var(--text); white-space: nowrap; }
  .copy:hover { background: rgb(255 255 255 / 0.16); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 4px; }
  .cta, .star { padding: 8px 22px; color: var(--text); text-decoration: none; }
  .cta { box-shadow: 0 0 0 1.5px var(--accent); }
  .cta:hover { background: var(--accent); color: var(--bg-deep); }
  .star { display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.32); }
  .star:hover { background: rgb(255 255 255 / 0.08); box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.6); }
  .star svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }

  /* not enough room outside the ring: the option label goes inside it */
  @media (max-width: 1100px) {
    .options a { flex-direction: row-reverse; }
    .options li { translate: calc(-100% + 8px) -50%; }
  }

  /* ---------- engine part labels (placed by the scene) ---------- */
  .parts { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .part {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    gap: 2px;
    padding: 0 0 0 14px;
    margin: -10px 0 0 34px;
    border-left: 1px solid var(--accent);
    opacity: 0;
    white-space: nowrap;
    text-shadow: 0 0 3px var(--bg), 0 0 12px var(--bg);
  }
  .part[data-side='left'] {
    margin: -10px 0 0 -34px;
    padding: 0 14px 0 0;
    border-left: 0;
    border-right: 1px solid var(--accent);
    text-align: right;
    translate: -100% 0;
  }
  .part-name { font-size: 15px; color: var(--text); }
  .part-step {
    font: 500 11px/1.4 var(--font-body);
    letter-spacing: var(--track-lede);
    text-transform: uppercase;
    color: var(--t-60);
  }
  .legend { display: none; }

  /* ---------- drive mode ---------- */
  /* bottom-right: one control with room around it, as in the reference */
  .drive-ctl {
    position: absolute;
    right: var(--edge);
    bottom: var(--edge);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 22px;
    animation: rise-in 0.9s var(--ease-out) 0.6s backwards;
  }
  @keyframes rise-in {
    from { opacity: 0; translate: 0 12px; }
  }
  /* after a drive: the visit's best split and top speed, for a few seconds */
  .debrief {
    position: absolute;
    right: 0;
    bottom: calc(100% + 22px);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-size: 15px;
    color: var(--t-80);
    opacity: 0;
    translate: 0 6px;
    transition: opacity 0.6s var(--ease-move), translate 0.6s var(--ease-out);
  }
  .debrief::before {
    content: '';
    width: 6px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px 1px rgb(225 6 0 / 0.8);
  }
  .debrief.on { opacity: 1; translate: 0 0; }
  .keys {
    display: grid;
    grid-template-columns: repeat(3, 24px);
    grid-template-rows: repeat(2, 24px);
    gap: 4px;
  }
  .cap {
    display: grid;
    place-items: center;
    border-radius: 3px;
    box-shadow: 0 0 0 1px var(--t-30);
    color: var(--t-40);
    transition: box-shadow 0.25s, color 0.25s, background 0.25s;
  }
  .cap svg { width: 10px; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .cap[data-cap='up'] { grid-column: 2; }
  .cap[data-cap='left'] { grid-column: 1; grid-row: 2; }
  .cap[data-cap='down'] { grid-column: 2; grid-row: 2; }
  .cap[data-cap='right'] { grid-column: 3; grid-row: 2; }
  .cap.on { color: var(--text); background: rgb(255 255 255 / 0.08); box-shadow: 0 0 0 1px var(--text), 0 0 10px rgb(255 255 255 / 0.25); }
  .drive-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 76px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(19 19 27);
    color: var(--text);
    font-size: 15px;
    cursor: pointer;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.55), 0 0 26px 4px rgb(225 6 0 / 0.18);
    transition: box-shadow 0.5s var(--ease-move);
  }
  .drive-toggle:hover, .drive-toggle:focus-visible { box-shadow: var(--ring-glow), 0 0 30px 8px rgb(225 6 0 / 0.35); }
  .drive-toggle[aria-pressed='true'] { color: var(--accent-muted); }
  .drive-chevrons {
    position: absolute;
    inset: -14px;
    fill: none;
    stroke: var(--t-40);
    stroke-width: 1.4;
    overflow: visible;
    transition: stroke 0.5s var(--ease-move), scale 0.5s var(--ease-move);
  }
  .drive-toggle:hover .drive-chevrons { stroke: var(--text); scale: 1.06; }

  .stage > :is(.intro, .stepper, .options, .bottom, .parts) { transition: opacity 0.6s var(--ease-move); }
  .is-driving > :is(.intro, .stepper, .options, .bottom, .parts) { opacity: 0; pointer-events: none; }
  .is-driving .keys .cap { color: var(--t-60); }
  .ring { transition: width 1.4s var(--ease-reveal), box-shadow 1.4s var(--ease-reveal), border-color 0.6s var(--ease-move); }
  .is-driving > .ring {
    width: min(150vh, 96vw);
    mask-image: none;
    border-color: transparent; /* the porthole keeps its dark surround, but no line runs through the HUD */
    box-shadow: 0 0 0 100vmax rgb(4 4 7 / 0.6), inset 0 0 140px 30px rgb(0 0 0 / 0.55), -24px 0 80px -12px rgb(225 6 0 / 0.45), 24px 0 80px -12px rgb(225 6 0 / 0.3);
  }
  .start { transition: opacity 0.6s var(--ease-move); }
  .is-engine .start { opacity: 0; pointer-events: none; }

  .hud {
    position: absolute;
    left: var(--edge);
    bottom: var(--edge);
    z-index: 3;
    display: grid;
    justify-items: center;
    width: 260px;
    animation: reveal 1s var(--ease-reveal);
  }
  .lights { display: flex; gap: 4px; margin-bottom: 6px; }
  .lights span {
    width: 9px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
  }
  .lights span.on { background: var(--text); box-shadow: 0 0 8px 1px rgb(255 255 255 / 0.7); }
