---
import Base from '../layouts/Base.astro';
import Menu from '../components/Menu.astro';
import { defaultLang, href, t } from '../i18n/ui';
import plugin from '../../../plugin/.claude-plugin/plugin.json';

const tr = t(defaultLang);
const repo = 'https://github.com/aontwit/pitwall';
// the three steps from the README's quick start, each copied on its own (Claude Code runs one command at a time)
const install = ['/plugin marketplace add aontwit/pitwall', '/plugin install pitwall@pitwall', '/pitwall:init'];

type Option = { command: string; to: string };
const doc = (command: string, to: string): Option => ({ command, to: href(to) });

// Stroke icons for the stage nodes, 24×24.
const ICONS = {
  plan: 'M9 3.5h6v3H9zM7.5 5H5.5v15.5h13V5h-2M8.5 11h7M8.5 14.5h7M8.5 18h4',
  queue: 'M4 6.5h2M4 12h2M4 17.5h2M9 6.5h11M9 12h11M9 17.5h11',
  lap: 'M3 10.5v5M3 13h2.5M5.5 9.5h3V8h6v1.5h2l2.5 2.5h1.5v-1.5h1.5v6h-1.5V15h-1.5L16 17.5H8.5l-3-3z',
  verify: 'M5 12.5l4.5 4.5L19 7.5',
  merge: 'M7 7v12M7 9.5c0 5.5 10 3.5 10 7.5M5 5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M15 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
} as const;

const stages: { label: string; icon: keyof typeof ICONS; title: string; lede: string; options: Option[] }[] = [
  {
    label: 'Plan',
    icon: 'plan',
    title: 'Interview, then write the rows',
    lede: 'Short rounds of tick-box questions. Every answer lands in the spec before the next round, and the plan ends as rows the queue can pick.',
    options: [doc('/pitwall:init', 'docs/playbooks/init/'), doc('/pitwall:plan', 'docs/playbooks/plan/')],
  },
  {
    label: 'Queue',
    icon: 'queue',
    title: 'Ask every question once',
    lede: 'Pick the tasks the agent can finish alone, then ask everything only a human can decide, up front, as tick boxes. Nobody gets asked at 2am.',
    options: [doc('/pitwall:queue', 'docs/playbooks/queue/')],
  },
  {
    label: 'Lap',
    icon: 'lap',
    title: 'The engine: one task per round',
    lede: 'Branch from base, code by playbook, prove it, review it, open the PR. The round never waits on a human for something it can decide.',
    options: [
      doc('/pitwall:drive', 'docs/playbooks/drive/'),
      doc('/pitwall:lap', 'docs/playbooks/lap/'),
      doc('/pitwall:stop', 'docs/playbooks/stop/'),
      doc('/pitwall:brake', 'docs/playbooks/brake/'),
    ],
  },
  {
    label: 'Verify',
    icon: 'verify',
    title: 'Evidence, not claims',
    lede: 'Checks run, the page is driven in a browser, and a verifier that did not write the code gives a verdict pinned to the patch-id.',
    options: [
      doc('/pitwall:gauge', 'docs/playbooks/gauge/'),
      doc('prove-it-works', 'docs/principles/prove-it-works/'),
    ],
  },
  {
    label: 'Merge',
    icon: 'merge',
    title: 'Humans merge',
    lede: 'Open PRs are ordered by stack and readiness. The agent never merges, force-pushes or touches a protected branch.',
    options: [doc('/pitwall:merge-order', 'docs/playbooks/merge-order/'), doc('opening-a-pr', 'docs/playbooks/opening-a-pr/')],
  },
];

// The engine on the Lap stage, one part per step of a round (in the order the round runs).
const engineParts = [
  { key: 'intake', name: 'Intake', step: 'Pick the next task', side: 'right' },
  { key: 'pistons', name: 'Pistons', step: 'Code, a subagent per role', side: 'right' },
  { key: 'ignition', name: 'Ignition', step: 'Gauge runs the proof', side: 'left' },
  { key: 'heads', name: 'Heads', step: 'Review panel, two models', side: 'right' },
  { key: 'crank', name: 'Crank', step: 'Verifier at the patch-id', side: 'left' },
  { key: 'exhaust', name: 'Exhaust', step: 'Open the PR', side: 'right' },
];

// Speed gauge: 0-360 km/h over a 240 degree sweep, a tick every 20, a number every 40.
const sweep = (kmh: number) => ((-120 + (kmh / 360) * 240) * Math.PI) / 180;
const at = (kmh: number, r: number) => ({ x: 100 + r * Math.sin(sweep(kmh)), y: 100 - r * Math.cos(sweep(kmh)) });
const ticks = Array.from({ length: 19 }, (_, i) => {
  const major = i % 2 === 0;
  const a = at(i * 20, major ? 78 : 84);
  const b = at(i * 20, 90);
  const n = at(i * 20, 64);
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, major, n: i * 20, tx: n.x, ty: n.y + 4 };
});
const arc = (from: number, to: number) => {
  const a = at(from, 90);
  const b = at(to, 90);
  return `M ${a.x} ${a.y} A 90 90 0 ${to - from > 270 ? 1 : 0} 1 ${b.x} ${b.y}`;
};
// what search engines read the page as
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'pitwall',
  description: 'A Claude Code plugin: the agent loop that queues your work, proves every PR, and leaves the merge to you.',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Claude Code',
  softwareVersion: plugin.version,
  license: 'https://opensource.org/licenses/MIT',
  url: Astro.site?.toString(),
  sameAs: 'https://github.com/aontwit/pitwall',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base title="pitwall — a Claude Code plugin that proves every PR">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="stage" data-stage-root>
    <canvas class="scene" aria-hidden="true"></canvas>
    <div class="poster" aria-hidden="true" style={`background-image: url(${href('hero-poster.jpg')})`}></div>
    <div class="ring" aria-hidden="true"></div>

    <header class="chrome top">
      <a class="wordmark" href={href('/')}><span>pit</span>wall</a>
      <Menu />
    </header>

    <div class="intro">
      <h1 class="pitch">The agent loop for Claude Code. It queues your work, proves every PR, and leaves the merge to you.</h1>
      {
        stages.map((s, i) => (
          <section data-panel hidden={i !== 0} aria-live="polite">
            <p class="eyebrow label">{tr('hero.stage')} {i + 1}</p>
            <h2 class="title label">{s.title}</h2>
            <p class="lede">{s.lede}</p>
          </section>
        ))
      }
    </div>

    <nav class="stepper" aria-label="The loop">
      <ol>
        {
          stages.map((s, i) => (
            <li style={`--i: ${i}`}>
              <button type="button" data-step aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="step-label label">{s.label}</span>
                <span class="node">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[s.icon]} /></svg>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      stages.map((s, i) => (
        <ul class="options label" data-option hidden={i !== 0}>
          {s.options.map((o, j) => (
            <li style={`--j: ${j}`}>
              <a href={o.to}>
                <span class="dot" />
                {o.command}
              </a>
            </li>
          ))}
        </ul>
      ))
    }

    <div class="parts" aria-hidden="true">
      {
        engineParts.map((p, i) => (
          <div class="part" data-part={p.key} data-side={p.side}>
            <span class="part-name label">
              {String(i + 1).padStart(2, '0')} {p.name}
            </span>
            <span class="part-step">{p.step}</span>
          </div>
        ))
      }
    </div>

    <div class="hud" data-hud hidden>
      <div class="lights" aria-hidden="true">{Array.from({ length: 15 }, () => <span />)}</div>
      <svg class="gauge" viewBox="0 0 200 200" role="img" aria-label="Speed">
        <path class="gauge-arc" d={arc(0, 360)} />
        <path class="gauge-red" d={arc(300, 360)} />
        {ticks.map((k) => <line class:list={['tick', { major: k.major }]} x1={k.x1} y1={k.y1} x2={k.x2} y2={k.y2} />)}
        {ticks.filter((k) => k.major).map((k) => <text class="tick-n" x={k.tx} y={k.ty}>{k.n}</text>)}
        <line class="needle" data-needle x1="100" y1="112" x2="100" y2="22" transform="rotate(-120 100 100)" />
        <circle class="hub" cx="100" cy="100" r="6" />
        <text class="speed" data-speed x="100" y="146">0</text>
        <text class="unit" x="100" y="162">KM/H</text>
      </svg>
      <p class="gear label" data-gear>N</p>
      <div class="pedals" aria-hidden="true">
        <span class="pedal"><span class="pedal-fill brake" data-pedal="brake"></span></span>
        <span class="pedal"><span class="pedal-fill throttle" data-pedal="throttle"></span></span>
      </div>
      <p class="hint">{tr('drive.hint')}</p>
    </div>

    <div class="pads" data-pads hidden>
      <div class="pad-group">
        <button type="button" class="pad label" data-key="left" aria-label={tr('drive.left')}>◀</button>
        <button type="button" class="pad label" data-key="right" aria-label={tr('drive.right')}>▶</button>
      </div>
      <div class="pad-group">
        <button type="button" class="pad label" data-key="down" aria-label={tr('drive.brake')}>BRK</button>
        <button type="button" class="pad pad-go label" data-key="up" aria-label={tr('drive.throttle')}>GO</button>
      </div>
    </div>

    <div class="drive-ctl">
      <div class="keys" aria-hidden="true">
        <span class="cap" data-cap="up"><svg viewBox="0 0 10 10"><path d="M2 6.5L5 3.5L8 6.5" /></svg></span>
        <span class="cap" data-cap="left"><svg viewBox="0 0 10 10"><path d="M6.5 2L3.5 5L6.5 8" /></svg></span>
        <span class="cap" data-cap="down"><svg viewBox="0 0 10 10"><path d="M2 3.5L5 6.5L8 3.5" /></svg></span>
        <span class="cap" data-cap="right"><svg viewBox="0 0 10 10"><path d="M3.5 2L6.5 5L3.5 8" /></svg></span>
      </div>
      <button type="button" class="drive-toggle" data-drive data-on={tr('drive.start')} data-off={tr('drive.exit')} aria-pressed="false">
        <svg class="drive-chevrons" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M45 6L50 1L55 6" /><path d="M6 45L1 50L6 55" /><path d="M94 45L99 50L94 55" />
        </svg>
        <span class="label" data-drive-label>{tr('drive.start')}</span>
      </button>
    </div>

    <footer class="chrome bottom">
      <a class="corner label" href="https://github.com/aontwit/pitwall/blob/main/CHANGELOG.md">v{plugin.version}</a>
      <div class="start">
        <p class="eyebrow label">{tr('hero.install')}</p>
        <ol class="install">
          {
            install.map((cmd) => (
              <li>
                <code>{cmd}</code>
                <button type="button" class="copy label" data-copy={cmd} data-done={tr('hero.copied')}>
                  <span data-copy-label>{tr('hero.copy')}</span><span class="visually-hidden"> {cmd}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <div class="actions">
          <a class="cta label" href={href('docs/')}>{tr('hero.cta')}</a>
          <a class="star label" href={repo}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
            {tr('hero.star')}
          </a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<script>
  import { mountCar, type Scene } from '../scripts/car';
  import { href } from '../i18n/ui';

  const root = document.querySelector<HTMLElement>('[data-stage-root]');
  const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const options = [...document.querySelectorAll<HTMLElement>('[data-option]')];

  let scene: Scene | undefined;
  const canvas = root?.querySelector<HTMLCanvasElement>('.scene');
  const labels = new Map([...document.querySelectorAll<HTMLElement>('[data-part]')].map((el) => [el.dataset['part'] ?? '', el]));
  // Ask the browser first: with WebGL off (hardware acceleration disabled, a blocked GPU) three.js would
  // only fail loudly. A browser without it, or a reader who asked for less motion, gets the still image.
  const webgl = ((): boolean => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return gl !== null;
    } catch {
      return false;
    }
  })();
  if (canvas && webgl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    try {
      scene = mountCar(canvas, { base: href(''), labels });
    } catch {
      scene = undefined; // a context that still failed to start
    }
  }
  root?.classList.toggle('static-hero', !scene);

  const select = (n: number): void => {
    steps.forEach((s, i) => s.setAttribute('aria-pressed', String(i === n)));
    panels.forEach((p, i) => (p.hidden = i !== n));
    options.forEach((o, i) => (o.hidden = i !== n));
    root?.style.setProperty('--active', String(n));
    root?.classList.toggle('is-engine', n === 2); // the exploded engine needs the bottom of the stage
    scene?.focus(n);
  };
  steps.forEach((s, i) => s.addEventListener('click', () => select(i)));

  // ---------- drive mode ----------
  const toggle = document.querySelector<HTMLButtonElement>('[data-drive]');
  const hud = document.querySelector<HTMLElement>('[data-hud]');
  const pads = document.querySelector<HTMLElement>('[data-pads]');
  const needle = document.querySelector<SVGLineElement>('[data-needle]');
  const speed = document.querySelector<SVGTextElement>('[data-speed]');
  const gear = document.querySelector<HTMLElement>('[data-gear]');
  const lights = [...document.querySelectorAll<HTMLElement>('.lights span')];
  const pedalBrake = document.querySelector<HTMLElement>('[data-pedal="brake"]');
  const pedalThrottle = document.querySelector<HTMLElement>('[data-pedal="throttle"]');
  let lastShifts = 0;
  const held = new Set<string>();
  let driving = false;
  let hudFrame = 0;

  const caps = [...document.querySelectorAll<HTMLElement>('[data-cap]')];
  const push = (): void => {
    caps.forEach((c) => c.classList.toggle('on', held.has(c.dataset['cap'] ?? '')));
    scene?.input({
      throttle: held.has('up') ? 1 : 0,
      brake: held.has('down') ? 1 : 0,
      steer: (held.has('left') ? 1 : 0) - (held.has('right') ? 1 : 0),
    });
  };

  const drawHud = (): void => {
    if (!scene) return;
    const { kmh, gear: g, rpm, throttle, brake, shifts } = scene.telemetry();
    needle?.setAttribute('transform', `rotate(${-120 + (Math.min(kmh, 360) / 360) * 240} 100 100)`);
    if (speed) speed.textContent = String(Math.round(kmh));
    if (gear) {
      gear.textContent = g === 0 ? 'N' : String(g);
      if (shifts !== lastShifts) {
        // restart the flash on every shift, up or down
        gear.classList.remove('shift');
        void gear.offsetWidth;
        gear.classList.add('shift');
        lastShifts = shifts;
      }
    }
    // shift lights fill from 7,000 rpm and are all lit at the 11,600 rpm upshift point
    const lit = Math.round(((rpm - 7000) / 4600) * lights.length);
    lights.forEach((l, i) => l.classList.toggle('on', i < lit));
    pedalBrake?.style.setProperty('scale', `1 ${brake}`);
    pedalThrottle?.style.setProperty('scale', `1 ${throttle}`);
    hudFrame = requestAnimationFrame(drawHud);
  };

  const setDriving = (on: boolean): void => {
    if (!scene) return;
    driving = on;
    held.clear();
    scene.drive(on);
    root?.classList.toggle('is-driving', on);
    if (hud) hud.hidden = !on;
    if (pads) pads.hidden = !on || !matchMedia('(pointer: coarse)').matches;
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(on));
      const label = toggle.querySelector<HTMLElement>('[data-drive-label]');
      if (label) label.textContent = (on ? toggle.dataset['off'] : toggle.dataset['on']) ?? '';
    }
    cancelAnimationFrame(hudFrame);
    if (on) hudFrame = requestAnimationFrame(drawHud);
  };
  toggle?.addEventListener('click', () => setDriving(!driving));
  if (!scene && toggle) toggle.hidden = true;

  const keyMap: Record<string, string> = {
    ArrowUp: 'up',
    KeyW: 'up',
    ArrowDown: 'down',
    KeyS: 'down',
    Space: 'down',
    ArrowLeft: 'left',
    KeyA: 'left',
    ArrowRight: 'right',
    KeyD: 'right',
  };
  window.addEventListener('keydown', (e) => {
    if (!driving) return;
    if (e.code === 'Escape') return setDriving(false);
    const k = keyMap[e.code];
    if (!k) return;
    e.preventDefault(); // arrows and space must not scroll the page while driving
    held.add(k);
    push();
  });
  window.addEventListener('keyup', (e) => {
    const k = keyMap[e.code];
    if (!k) return;
    held.delete(k);
    push();
  });
  window.addEventListener('blur', () => {
    held.clear();
    push();
  });
  pads?.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) => {
    const k = b.dataset['key'] ?? '';
    const release = (): void => {
      held.delete(k);
      push();
    };
    b.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      b.setPointerCapture(e.pointerId);
      held.add(k);
      push();
    });
    b.addEventListener('pointerup', release);
    b.addEventListener('pointercancel', release);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const text = btn.querySelector<HTMLElement>('[data-copy-label]');
    if (!text) return;
    const label = text.textContent;
    let reset = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset['copy'] ?? '');
        text.textContent = btn.dataset['done'] ?? label;
      } catch {
        // clipboard blocked (permissions, insecure context): select the command so the reader can copy it
        const code = btn.parentElement?.querySelector('code');
        if (code) getSelection()?.selectAllChildren(code);
        text.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? 'Press ⌘C' : 'Press Ctrl+C';
      }
      clearTimeout(reset);
      reset = window.setTimeout(() => (text.textContent = label), 2400);
    });
  });
</script>

<style>
  .stage {
    --r: min(42vh, 34vw, 470px);
    --cy: 52%;
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% var(--cy), #1d1d29 0%, var(--bg) 60%, var(--bg-deep) 100%);
  }

  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* the still image for browsers without WebGL and for reduced motion */
  .poster {
    position: absolute;
    inset: 0;
    background: center 52% / cover no-repeat;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s var(--ease-reveal);
  }
  .static-hero .poster { opacity: 1; }
  .static-hero .drive-ctl { display: none; } /* no scene, nothing to drive */
  @media (max-aspect-ratio: 1/1) {
    .poster { background-size: 150vw auto; }
  }

  .ring {
    position: absolute;
    left: 50%;
    top: var(--cy);
    width: calc(var(--r) * 2);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1.5px solid rgb(255 255 255 / 0.7);
    box-shadow: -18px 0 60px -20px rgb(225 6 0 / 0.5), 18px 0 60px -20px rgb(225 6 0 / 0.3);
    mask-image: linear-gradient(to bottom, transparent 4%, #000 30%, #000 70%, transparent 96%);
    pointer-events: none;
  }

  .chrome {
    position: absolute;
    inset-inline: var(--edge);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .top { top: var(--edge); z-index: 60; } /* above the stage UI, so the open menu covers it */
  .bottom {
    bottom: var(--edge);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
  }

  .corner {
    color: var(--t-60);
    text-decoration: none;
    transition: color 0.5s var(--ease-move);
  }
  .corner:hover { color: var(--text); }
  .corner { font-size: 16px; justify-self: start; } /* the link is the version, not the grid column */

  .intro {
    position: absolute;
    top: clamp(76px, 11vh, 110px);
    left: 50%;
    translate: -50% 0;
    width: min(780px, calc(100% - 2 * var(--edge)));
    text-align: center;
    z-index: 2;
  }
  .intro section:not([hidden]) { animation: reveal 2s var(--ease-reveal); }
  .pitch {
    margin: 0 auto 22px;
    max-width: 44ch;
    font: 500 clamp(16px, 1.4vw, 19px)/1.45 var(--font-body);
    color: var(--t-80);
    text-wrap: balance;
  }
  .eyebrow {
    margin: 0;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: var(--track-eyebrow);
    color: var(--t-80);
  }
  .title {
    margin: 8px 0 10px;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.3;
    letter-spacing: var(--track-lede);
  }
  .lede {
    margin: 0 auto;
    max-width: 52ch;
    font: 500 11px/18px var(--font-body);
    letter-spacing: var(--track-lede);
    text-transform: uppercase;
    color: var(--t-60);
  }

  .stepper ol { list-style: none; margin: 0; padding: 0; }
  .stepper li {
    --a: calc(198deg - var(--i) * 9deg);
    --node: 48px;
    position: absolute;
    left: calc(50% + var(--r) * cos(var(--a)));
    top: calc(var(--cy) + var(--r) * sin(var(--a)));
    /* the node's centre, not the button's edge, lands on the ring */
    translate: calc(-100% + var(--node) / 2) -50%;
    z-index: 2;
  }
  .stepper button {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .stepper button:focus-visible { box-shadow: none; }
  .step-label {
    font-size: 20px;
    opacity: 0.3;
    transition: opacity 0.6s var(--ease-move);
  }
  .stepper button:hover .step-label, .stepper button:focus-visible .step-label { opacity: 0.75; }
  [aria-pressed='true'] .step-label { opacity: 1; }
  .node {
    display: grid;
    place-items: center;
    width: var(--node);
    aspect-ratio: 1;
    border-radius: 50%;
